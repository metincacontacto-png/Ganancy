# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paddle Configuration (cliente — seguras de exponer en el navegador)
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_PRICE_ID_PLAN_PERSONAL=
VITE_PADDLE_PRICE_ID_PLAN_COMPLETO=
VITE_PADDLE_PRICE_ID_PLAN_FAMILIAR=

# ---------------------------------------------------------------------------
# Las siguientes variables NO van acá ni en .env: son secretos de servidor
# para la Cloudflare Pages Function (functions/api/paddle-webhook.js).
# Se configuran en Cloudflare Pages → Settings → Environment variables,
# como tipo "Secret" (excepto las dos últimas, que no son secretas):
#
#   PADDLE_NOTIFICATION_WEBHOOK_SECRET
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_URL                          (mismo valor que VITE_SUPABASE_URL)
#   PADDLE_PRICE_ID_PLAN_PERSONAL         (mismo valor que VITE_PADDLE_PRICE_ID_PLAN_PERSONAL)
#   PADDLE_PRICE_ID_PLAN_COMPLETO         (mismo valor que VITE_PADDLE_PRICE_ID_PLAN_COMPLETO)
#   PADDLE_PRICE_ID_PLAN_FAMILIAR         (mismo valor que VITE_PADDLE_PRICE_ID_PLAN_FAMILIAR)
#
# Para correr scripts/seed-paddle-catalog.js localmente (una sola vez):
#   PADDLE_API_KEY=pdl_sdbx_apikey_...
# ---------------------------------------------------------------------------
